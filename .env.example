# OpenRouter — генерация сценария (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Kie.ai — озвучка (модели ElevenLabs) и картинки (https://kie.ai)
# Один ключ на оба сервиса, отдельный аккаунт ElevenLabs не нужен.
KIE_API_KEY=

# Озвучка: голос и скорость (0.7-1.2).
# Для русского языка нужен голос с поддержкой multilingual.
KIE_TTS_MODEL=elevenlabs/text-to-speech-multilingual-v2
KIE_TTS_VOICE=Rachel
KIE_TTS_SPEED=1

# Картинки: модель с поддержкой входных изображений (image-to-image),
# нужна для сохранения внешности персонажа между сценами.
KIE_IMAGE_MODEL=google/nano-banana-edit

# Как часто спрашивать готовность задачи и сколько ждать максимум.
KIE_POLL_INTERVAL_SECONDS=3
KIE_TIMEOUT_SECONDS=600

# Эталон внешности персонажа — публичная ссылка на картинку.
# По умолчанию берётся из этого репозитория на GitHub; заполняйте, только
# если репозиторий стал приватным или нужен другой персонаж.
CHARACTER_REFERENCE_URL=

# Формат видео (по умолчанию — вертикальный 9:16 под Reels/Shorts/TikTok/VK Клипы)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
