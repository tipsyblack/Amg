# OpenRouter — генерация сценария (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Веб-поиск для сценария: без него «актуальные темы» опираются на дату
# обучения модели. Плагин OpenRouter стоит ~$4 за 1000 результатов, то есть
# копейки на ролик. SCRIPT_WEB_SEARCH=0 — писать по знаниям модели.
# Если плагин недоступен на аккаунте, запрос повторяется без него, а бот
# предупреждает в чате — генерация не падает.
SCRIPT_WEB_SEARCH=1
SCRIPT_WEB_SEARCH_RESULTS=3

# Проверка сценария моделью-критиком по чек-листу data/review-checklist.md.
# Правила вкуса (тема ведёт к продукту, финал даёт вывод, призыв конкретный)
# лежат текстом в этом файле, а не в коде: на контент-заводе правка правила
# не должна упираться в программиста и деплой. Редактируется командой /rules
# прямо из чата. Стоит одну дешёвую генерацию на сценарий.
SCRIPT_REVIEW=1

# Те же правила вкуса, но регулярками в коде. Дешевле критика и срабатывают
# детерминированно, зато ловят формулировку, а не смысл, и на потоке разных
# тем начинают отставать. SCRIPT_TASTE_RULES=0 оставит только критика и
# структурные проверки (ритм, длина хука, реклама не в финале) — их
# выключить нельзя, они объективны.
SCRIPT_TASTE_RULES=1

# Цель по длине текста описания под ролик (символов). Бот присылает его вместе
# с видео — вставлять в описание публикации. Жёсткий предел — 500 символов, он
# задан в коде и гарантируется обрезкой на выходе; здесь цель, и она должна быть
# ниже предела, иначе модель регулярно через него перескакивает.
DESCRIPTION_CHARS=450

# Kie.ai — озвучка (модели ElevenLabs) и картинки (https://kie.ai)
# Один ключ на оба сервиса, отдельный аккаунт ElevenLabs не нужен.
KIE_API_KEY=

# Озвучка. KIE_TTS_VOICE — ID голоса ElevenLabs (20 символов). Имена
# классических голосов (Rachel, Bella, Antoni, Josh, Adam) тоже понимаются —
# подставляются в ID автоматически. Пусто = Rachel.
# Подобрать голос удобнее командой /voice в боте: пришлёт пробную фразу.
# TTS_SPEED — скорость речи, 0.7-1.2, общая для обоих путей озвучки. 1.13 —
# это замер: наша речь шла 2.06 слова в секунду против 2.33 у референса.
# СТАРОЕ ИМЯ KIE_TTS_SPEED ещё понимается, но если оно осталось в вашем .env
# со значением 1, оно ПЕРЕБИВАЕТ новое умолчание — уберите его оттуда или
# поставьте скорость командой /speed в боте.
# KIE_TTS_LANGUAGE_CODE: пусто = язык определяется автоматически. Пустое
# значение НЕ отправляется в API — Kie.ai отвергает пустой language_code.
KIE_TTS_MODEL=elevenlabs/text-to-speech-multilingual-v2
KIE_TTS_VOICE=
TTS_SPEED=1.13
KIE_TTS_LANGUAGE_CODE=

# Резервная озвучка напрямую через ElevenLabs — нужна, если прокси Kie.ai для
# их моделей не работает. Провайдер переключается командой /tts в боте;
# TTS_PROVIDER задаёт значение по умолчанию (kie или elevenlabs).
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Похожесть голоса (ElevenLabs, действует для оба провайдера). Значения по
# умолчанию подобраны под клонированный голос: TTS_SIMILARITY_BOOST ближе к 1
# держит тембр исходной записи, TTS_STYLE выше нуля начинает «играть» и уводит
# от оригинала, TTS_STABILITY ниже 0.5 оставляет живую интонацию (1.0 — ровный
# диктор). TTS_SPEAKER_BOOST=0 отключает усиление сходства.
# Клонированный голос из вашего аккаунта работает только при TTS_PROVIDER
# elevenlabs: прокси Kie.ai ходит в ElevenLabs со своего аккаунта.
TTS_STABILITY=0.4
TTS_SIMILARITY_BOOST=0.9
TTS_STYLE=0
TTS_SPEAKER_BOOST=1

# Субтитры по словам под подписью. Точные тайминги приходят от прямого
# ElevenLabs вместе со звуком (эндпоинт with-timestamps); через прокси Kie.ai
# таймингов нет, и слова раскладываются по длине реплики приблизительно.
WORD_SUBTITLES=1

# Музыка: модель Suno через Kie.ai и лимит ожидания (генерация небыстрая).
# KIE_MUSIC_CALLBACK_URL: Suno требует это поле обязательно (иначе 422), но
# результат мы забираем опросом статуса. Пусто = заглушка на example.com.
KIE_MUSIC_MODEL=V5
KIE_MUSIC_TIMEOUT_SECONDS=600
KIE_MUSIC_CALLBACK_URL=

# Картинки: модель с поддержкой входных изображений (image-to-image),
# нужна для сохранения внешности персонажа между сценами.
KIE_IMAGE_MODEL=google/nano-banana-edit

# Оживление кадра (image-to-video, Seedance). Клип делается из уже
# согласованной картинки сцены — она идёт его первым кадром, поэтому стиль не
# «уплывает». Оживляются в первую очередь хук и финал.
#
# CLIP_SCENES=0 — клипов нет вовсе (по умолчанию). Клип — самая дорогая часть
# сцены: четыре секунды на Seedance 2.0 Mini стоят порядка $0.22, а на полной
# 2.0 — вдвое дороже картинки и озвучки вместе. Включать удобнее командой
# /clips в боте: она называет цену по выбранной модели.
#
# CLIP_SECONDS=4 — минимум, который принимает Seedance 2 (диапазон 4-15).
# Просьба о двух секундах отвергается запросом, поэтому меньше ставить нельзя;
# клип всё равно обычно длиннее сцены, и остаток она досиживает на его
# последнем кадре.
#
# CLIP_RESOLUTION — регистр буквы в документации Kie.ai написан по-разному:
# примеры для V1 строчной («720p»), описания Seedance 2 прописной («720P»).
# Если проба ругается на разрешение, поменяйте здесь — правка кода не нужна.
#
# KIE_VIDEO_MODEL — точный слаг модели. Пусто = берётся из реестра
# src/pipeline/videoModels.ts, где по умолчанию bytedance/seedance-2-mini.
# Заполнять эту переменную стоит только когда слаг точно известен: она
# перебивает реестр целиком, и выбор модели через /vidmodel перестаёт влиять
# на что-либо — слаг всегда будет отсюда.
#
# CLIP_SOURCE — откуда брать клип:
#   auto     — готовый из библиотеки маскота, если есть, иначе оживить картинку
#              сцены за деньги (по умолчанию);
#   library  — только библиотека, платных генераций не делать вовсе;
#   generate — всегда оживлять картинку сцены, библиотеку не трогать.
# Библиотека — десять клипов с Шамилем, генерируются один раз командой
# `npm run clips:build` (или /library build в боте) и дальше подставляются
# бесплатно.
CLIP_SCENES=0
CLIP_SECONDS=4
CLIP_RESOLUTION=720p
CLIP_SOURCE=auto
KIE_VIDEO_MODEL=

# Как часто спрашивать готовность задачи и сколько ждать максимум.
KIE_POLL_INTERVAL_SECONDS=3
KIE_TIMEOUT_SECONDS=600

# Эталон внешности персонажа — публичная ссылка на картинку.
# По умолчанию assets/characters/shamil-clip.png из этого репозитория на
# GitHub. Это НЕ исходный shamil.png: тот — рекламный стикер на фотографии
# офиса, лицо занимает 18% высоты кадра, и после сжатия до 720p от него
# остаётся меньше шестидесяти пикселей — модель дорисовывает лицо заново.
# В shamil-clip.png фон белый, лампа с надписью отрезана, лицо занимает 34%.
# Пересобрать из исходника: npm run character:ref
CHARACTER_REFERENCE_URL=

# Замок внешности для клипов библиотеки: тот же эталон уходит и последним
# кадром, поэтому персонаж обязан к концу клипа вернуться ровно к нему.
# Держит лицо крепче, но движение получается «туда и обратно» — жест
# возвращается в исходную позу. Включайте, если после нового эталона лицо всё
# равно плывёт. Работает только у Seedance 2.x: у V1 последнего кадра нет.
CLIP_LOCK_IDENTITY=0

# Сколько сцен показать БЕЗ КАРТОЧКИ — маскот во весь рост прямо на белом
# фоне. Приём из присланного референса: карточка на этих сценах исчезает
# совсем, персонаж занимает 61% высоты кадра. У нас маскот всегда сидел внутри
# рамки, и именно поэтому ролики выглядели однообразнее — рамка не ломалась ни
# разу. Такой сцене не нужна иллюстрация: рисовать нечего, и одна генерация
# картинки на ролик экономится.
# Одна сцена по умолчанию (финал — там маскот обращается к зрителю): приём
# сильный, но от повторения стирается. 0 отключает.
MASCOT_SCENES=1

# Маскот появляется только в хуке и в финале: в каждой сцене он превращал ролик
# в галерею поз одного персонажа, а середина ролика — про содержание истории.
# CHARACTER_EVERY_SCENE=1 вернёт его во все сцены.
CHARACTER_EVERY_SCENE=0

# Телеграм-бот (создать у @BotFather, команда /newbot)
TELEGRAM_BOT_TOKEN=

# Необязательно: пустить в бота только один чат (ваш chat id — его покажет
# @userinfobot). Пусто = бот отвечает всем, кто его найдёт.
TELEGRAM_ALLOWED_CHAT_ID=

# Сколько сцен максимум и в какую длину должен уложиться ролик.
# Чем больше сцен при том же лимите, тем короче реплики в каждой.
MAX_SCENES=15
MAX_VIDEO_SECONDS=60

# Брендовая концовка — последний кадр ролика: тёмная плашка с названием и
# строчкой помельче. Пустое BRAND_NAME отключает её целиком.
# BRAND_LOGO_FILE — имя файла в public/brand/. По умолчанию logo.png — он лежит
# в репозитории (вырезан из концовки присланного референса). Если файла нет,
# кадр соберётся из одного текста: ссылка на несуществующий файл уронила бы
# рендер на последнем кадре, когда всё дорогое уже посчитано.
BRAND_NAME=PRO NEIRO
BRAND_TAGLINE=
BRAND_LOGO_FILE=logo.png
OUTRO_SECONDS=2

# Громкость готового ролика (LUFS, EBU R128). Снята с присланного референса:
# все 11 агентских роликов лежат на −9.8…−12.2 LUFS при разбросе громкости
# около 1 LU, то есть это прижатая лимитером «радийная» речь. Наш первый ролик
# измерялся на −14.6 LUFS — на телефоне в шуме это и слышно как «у них фон
# другой», хотя фоновой музыки в референсе нет вовсе.
#
# Берём −12: нижний край референсного диапазона. Громче ставить смысла нет —
# площадки всё равно приводят к своей норме (у большинства −14), а
# перелимитированный звук после их нормализации звучит плоско.
#
# Операция идёт после рендера и картинку не пересчитывает. MASTER_LUFS=0
# отключает выравнивание.
MASTER_LUFS=-12

# Формат видео (по умолчанию — вертикальный 9:16 под Reels/Shorts/TikTok/VK Клипы)
# VIDEO_FPS=60 — как в референсе: резкие стыки длятся 0.3 с, и на 30 кадрах
# движение читается рвано. Рендер при 60 примерно вдвое дольше; 30 вернёт как было.
VIDEO_FPS=60
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Zernio — привязка аккаунтов соцсетей (zernio.com).
# Пусто = интеграция выключена, бот об этом честно скажет.
# ВКонтакте Zernio НЕ поддерживает: VK Клипы придётся заливать отдельно.
ZERNIO_API_KEY=
# Профиль, внутрь которого подключаются аккаунты. Пусто — профиль по умолчанию.
ZERNIO_PROFILE_ID=
# Часовой пояс канала: в нём понимается «/schedule 18:00». Сервер обычно живёт
# по UTC, и без этого вечерний слот уехал бы на несколько часов.
POST_TIMEZONE=Europe/Moscow
