# OpenRouter — генерация сценария и картинок (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# ElevenLabs — озвучка (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Формат видео (по умолчанию — вертикальный 9:16 под Reels/Shorts/TikTok/VK Клипы)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
