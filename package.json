{
  "name": "amg-video-pipeline",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Пайплайн автогенерации коротких видео: сценарий (OpenRouter) + картинки и озвучка (Kie.ai) + сборка ролика (Remotion)",
  "scripts": {
    "generate": "tsx src/pipeline/index.ts",
    "bot": "tsx src/bot/index.ts",
    "preview": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts VideoComposition out/video.mp4 --props=data/video-data.json",
    "typecheck": "tsc --noEmit",
    "test:kie": "tsx scripts/test-kie-client.mjs",
    "test:bot": "tsx scripts/test-bot-commands.mjs",
    "test:elevenlabs": "tsx scripts/test-elevenlabs.mjs",
    "test:images": "tsx scripts/test-image-models.mjs",
    "test:profiles": "tsx scripts/test-profiles.mjs",
    "test:timing": "tsx scripts/test-timing.mjs",
    "test:music": "tsx scripts/test-music.mjs",
    "test:clone": "tsx scripts/test-voice-clone.mjs",
    "test:drive": "tsx scripts/test-drive.mjs",
    "test:script": "tsx scripts/test-script.mjs",
    "test:size": "tsx scripts/test-video-size.mjs",
    "test:subs": "tsx scripts/test-subtitles.mjs",
    "test:overlays": "tsx scripts/test-overlays.mjs",
    "test:description": "tsx scripts/test-description.mjs",
    "test:clips": "tsx scripts/test-clips.mjs",
    "clips:build": "tsx scripts/build-clip-library.mjs"
  },
  "dependencies": {
    "@remotion/captions": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/motion-blur": "4.0.499",
    "@remotion/paths": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "@remotion/shapes": "4.0.499",
    "@remotion/transitions": "4.0.499",
    "dotenv": "16.4.5",
    "grammy": "1.45.1",
    "music-metadata": "10.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.499",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
